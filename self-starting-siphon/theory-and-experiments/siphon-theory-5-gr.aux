\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Πάνω: Κινητήρια δύναμη $F(L) = \rho g A[h_c^{(0)} - h(L)]$ ως συνάρτηση του μήκους τόξου. Η δύναμη αλλάζει πρόσημο στις τομές με τη στάθμη. Κάτω: Επιτάχυνση $a(L) = g[h_c^{(0)} - h(L)]/L$. Ακόμη και στο σημείο $C$ όπου η δύναμη είναι μέγιστη, η επιτάχυνση μετριάζεται από το μήκος του βύσματος $L$. Ο παράγοντας $1/L$ προκαλεί μείωση της επιτάχυνσης καθώς το βύσμα μεγαλώνει.}}{12}{figure.3}\protected@file@percent }
\newlabel{fig:force-acceleration}{{3}{12}{Πάνω: Κινητήρια δύναμη $F(L) = \rho g A[h_c^{(0)} - h(L)]$ ως συνάρτηση του μήκους τόξου. Η δύναμη αλλάζει πρόσημο στις τομές με τη στάθμη. Κάτω: Επιτάχυνση $a(L) = g[h_c^{(0)} - h(L)]/L$. Ακόμη και στο σημείο $C$ όπου η δύναμη είναι μέγιστη, η επιτάχυνση μετριάζεται από το μήκος του βύσματος $L$. Ο παράγοντας $1/L$ προκαλεί μείωση της επιτάχυνσης καθώς το βύσμα μεγαλώνει}{figure.3}{}}
\newlabel{fig:force-acceleration@cref}{{[figure][3][]3}{[1][12][]12}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Ενεργειακό ολοκλήρωμα $I(L)$ ως συνάρτηση του μήκους τόξου (χωρίς τριβές, χωρίς πτώση στάθμης). Το ολοκλήρωμα αυξάνει κατά την πτώση $B \to C$, συνεχίζει να αυξάνει στην αρχή της ανόδου (όπου $h < h_c^{(0)}$), και στη συνέχεια μειώνεται ελαφρά όσο το μέτωπο βρίσκεται πάνω από τη στάθμη (μεταξύ $W'$ και $W$). Στο σημείο $W$, $I(S_W) = 3.82$\,cm $> 0$: η προπλήρωση επιτυγχάνει.}}{13}{figure.4}\protected@file@percent }
\newlabel{fig:energy-integral}{{4}{13}{Ενεργειακό ολοκλήρωμα $I(L)$ ως συνάρτηση του μήκους τόξου (χωρίς τριβές, χωρίς πτώση στάθμης). Το ολοκλήρωμα αυξάνει κατά την πτώση $B \to C$, συνεχίζει να αυξάνει στην αρχή της ανόδου (όπου $h < h_c^{(0)}$), και στη συνέχεια μειώνεται ελαφρά όσο το μέτωπο βρίσκεται πάνω από τη στάθμη (μεταξύ $W'$ και $W$). Στο σημείο $W$, $I(S_W) = 3.82$\,cm $> 0$: η προπλήρωση επιτυγχάνει}{figure.4}{}}
\newlabel{fig:energy-integral@cref}{{[figure][4][]4}{[1][12][]13}}
