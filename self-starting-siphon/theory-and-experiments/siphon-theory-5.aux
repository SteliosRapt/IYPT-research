\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Top: Driving force $F(L) = \rho g A[h_c^{(0)} - h(L)]$ versus arclength. The force changes sign at waterline crossings. Bottom: Acceleration $a(L) = g[h_c^{(0)} - h(L)]/L$. Even at point $C$ where the force is maximum, the acceleration is moderated by the slug length $L$. The $1/L$ factor causes acceleration to decrease as the slug grows.}}{12}{figure.3}\protected@file@percent }
\newlabel{fig:force-acceleration}{{3}{12}{Top: Driving force $F(L) = \rho g A[h_c^{(0)} - h(L)]$ versus arclength. The force changes sign at waterline crossings. Bottom: Acceleration $a(L) = g[h_c^{(0)} - h(L)]/L$. Even at point $C$ where the force is maximum, the acceleration is moderated by the slug length $L$. The $1/L$ factor causes acceleration to decrease as the slug grows}{figure.3}{}}
\newlabel{fig:force-acceleration@cref}{{[figure][3][]3}{[1][11][]12}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Energy integral $I(L)$ versus arclength (frictionless, no drawdown). The integral rises during the drop $B \to C$, continues rising during the early climb (where $h < h_c^{(0)}$), then decreases slightly while the front is above the waterline (between $W'$ and $W$). At point $W$, $I(S_W) = 3.82$\,cm $> 0$: priming succeeds.}}{13}{figure.4}\protected@file@percent }
\newlabel{fig:energy-integral}{{4}{13}{Energy integral $I(L)$ versus arclength (frictionless, no drawdown). The integral rises during the drop $B \to C$, continues rising during the early climb (where $h < h_c^{(0)}$), then decreases slightly while the front is above the waterline (between $W'$ and $W$). At point $W$, $I(S_W) = 3.82$\,cm $> 0$: priming succeeds}{figure.4}{}}
\newlabel{fig:energy-integral@cref}{{[figure][4][]4}{[1][12][]13}}
