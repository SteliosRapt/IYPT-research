\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Validity regime diagrams. (a) Diameter $D$ versus crest height $h_3 - h_c$: cavitation limits tall crests; capillarity limits small diameters. (b) Reynolds number versus capillary number: highlights the laminar/transition boundary and the small-$\text  {Ca}$ regime. (c) $L/D$ versus Reynolds number: high $L/D$ means friction-dominated flow; entrance-length and quasi-steady assumptions become questionable at low Re. The worked example (marked) lies close to the capillary/entrance-effect boundaries.}}{28}{figure.10}\protected@file@percent }
\newlabel{fig:validity}{{10}{28}{Validity regime diagrams. (a) Diameter $D$ versus crest height $h_3 - h_c$: cavitation limits tall crests; capillarity limits small diameters. (b) Reynolds number versus capillary number: highlights the laminar/transition boundary and the small-$\text {Ca}$ regime. (c) $L/D$ versus Reynolds number: high $L/D$ means friction-dominated flow; entrance-length and quasi-steady assumptions become questionable at low Re. The worked example (marked) lies close to the capillary/entrance-effect boundaries}{figure.10}{}}
\newlabel{fig:validity@cref}{{[figure][10][]10}{[1][28][]28}}
