\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Schematic diagram of the self-starting siphon geometry. The pipe centerline is defined by points $A(0,h_0)$, $B(x_1,h_1)$, $C(x_2,h_2)$, $D(x_3,h_3)$, and $E(x_4,h_4)$, with straight segments of lengths $L_1$, $L_2$, $L_3$, and $L_4$. The container has free-surface area $A_0$ and water level $h_c(t)$; the pipe has cross-sectional area $A$ and diameter $D$. The arc-length coordinate $L(t)$ measures the wetted pipe length during the filling phase.}}{1}{figure.1}\protected@file@percent }
\newlabel{fig:siphon-schematic}{{1}{1}{Schematic diagram of the self-starting siphon geometry. The pipe centerline is defined by points $A(0,h_0)$, $B(x_1,h_1)$, $C(x_2,h_2)$, $D(x_3,h_3)$, and $E(x_4,h_4)$, with straight segments of lengths $L_1$, $L_2$, $L_3$, and $L_4$. The container has free-surface area $A_0$ and water level $h_c(t)$; the pipe has cross-sectional area $A$ and diameter $D$. The arc-length coordinate $L(t)$ measures the wetted pipe length during the filling phase}{figure.1}{}}
