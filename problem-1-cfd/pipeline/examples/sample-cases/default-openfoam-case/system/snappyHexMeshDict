    }
    tubeOutlet.stl
    {
        type triSurfaceMesh;
        name tubeOutlet;
    }
    solidObstructions.stl
    {
        type triSurfaceMesh;
        name solidObstructions;
    }
    openingBox
    {
        type searchableBox;
        min (0.169132896932 0.27542538527039995 -0.0095746147296);
        max (0.17713289693200002 0.2945746147296 0.0095746147296);
    }
    bendBoxP2
    {
        type searchableBox;
        min (0.14313289693200001 0.255 -0.03);
        max (0.203132896932 0.31499999999999995 0.03);
    }
    bendBoxP3
    {
        type searchableBox;
        min (0.215070369781 0.09 -0.03);
        max (0.27507036978099997 0.15 0.03);
