    bendBoxP4
    {
        type searchableBox;
        min (0.33254377102599997 0.30500000000000005 -0.03);
        max (0.392543771026 0.365 0.03);
    }
    outletBox
    {
        type searchableBox;
        min (0.5370612196906 0.0554253852704 -0.0095746147296);
