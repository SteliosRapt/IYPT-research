FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object controlDict;
}

application interFoam;
startFrom startTime;
startTime 0.0;
stopAt endTime;
endTime 15.0;
deltaT 0.02;
writeControl adjustableRunTime;
writeInterval 0.1;
purgeWrite 0;
writeFormat ascii;
writePrecision 8;
writeCompression off;
timeFormat general;
timePrecision 6;
runTimeModifiable true;
